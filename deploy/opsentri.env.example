# Настройки сервиса Opsentri. Ставится в /etc/opsentri/opsentri.env.
# После правки: sudo systemctl restart opsentri

OPSENTRI_HOST=0.0.0.0
OPSENTRI_PORT=8080

# Отладчик Flask на сервере выключен: в debug-режиме страница ошибки
# даёт интерактивную консоль Python.
OPSENTRI_DEBUG=0

# Только если приложение за HTTPS (иначе вход перестанет работать).
#OPSENTRI_COOKIE_SECURE=1

# Окружение Greenplum для gpcopy / gpbackup / gprestore.
# systemd не раскрывает $PATH — путь пишется целиком.
GPHOME=@GPHOME@
PATH=@GPHOME@/bin:/usr/local/bin:/usr/bin:/bin

#GPCOPY_PATH=/usr/local/bin/gpcopy
#GPCOPY_RPC_PORTS=7667-7699

PYTHONUNBUFFERED=1
